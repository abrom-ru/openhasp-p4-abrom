# ============================================================
# ESP32-S3 common defaults
# ============================================================

CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# ============================================================
# WIFI CONFIG
# ============================================================

# Use native WiFi : Disable Remote WiFi
CONFIG_ESP_WIFI_REMOTE_ENABLED=n

# Fix for: wifi:[ADDBA]RX DELBA, reason:39, delete tid:0, initiator:0(recipient)
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=n
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n

# ============================================================
# LVGL CONFIG
# ============================================================

# LVGL software rendering
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2

# ============================================================
# PSRAM Runtime Policies
# ============================================================

CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_RAM=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
